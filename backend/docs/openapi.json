          },
          "budget": {
            "type": "integer",
            "title": "Budget",
            "default": 400
          },
          "clientRequestId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Clientrequestid"
          }
